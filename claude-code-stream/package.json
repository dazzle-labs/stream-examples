{
  "name": "claude-code-stream",
  "version": "1.0.0",
  "description": "Live visualization of an AI coding agent at work. Every tool call -- file reads, edits, bash commands, grep searches, subagent spawns -- appears on a Dazzle stage in real time, the moment it happens. Your audience watches the AI think.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "bridge": "npx tsx scripts/server.ts",
    "local": "concurrently \"npm run dev\" \"npm run bridge\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  }
}
